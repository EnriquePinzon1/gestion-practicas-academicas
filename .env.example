# ========================================================
# Supabase (todos los servicios)
# ========================================================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# ========================================================
# Comunicación entre servicios
# ========================================================
# Secreto compartido (mismo valor en Gateway y en los 3 servicios).
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# URLs de los microservicios. Opcionales en local
# (por defecto http://localhost:3334, :3335 y :3336).
# USER_SERVICE_URL=https://user-service.onrender.com
# PRACTICE_SERVICE_URL=https://practice-service.onrender.com
# ACTIVITY_SERVICE_URL=https://activity-service.onrender.com

# ========================================================
# Frontend
# ========================================================
# Orígenes autorizados por CORS en el Gateway, separados por coma.
# Por defecto http://localhost:4200.
# CORS_ALLOWED_ORIGINS=https://gestion-practicas.vercel.app

# URL pública del frontend para los enlaces de invitación (user-service).
# Por defecto http://localhost:4200.
# WEB_APP_URL=https://gestion-practicas.vercel.app
